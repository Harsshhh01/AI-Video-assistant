# Copy this file to ".env" and fill in your keys.
# Nothing here is committed — .env is listed in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────
# Summaries, extraction and chat answers. Free tier available.
# Get one at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Only needed for the "Hinglish" language option (speech -> English translation).
# Get one at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# ── Tuning (safe to leave as-is) ──────────────────────────────────────────────
# Whisper size: tiny | base | small | medium | large
#   tiny/base  → fastest, roughest
#   small      → good balance (default)
#   medium     → noticeably better, ~3x slower
WHISPER_MODEL=small

MISTRAL_MODEL=mistral-small-latest
SARVAM_STT_MODEL=saaras:v2.5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Minutes of audio per transcription chunk, and the upload size ceiling in MB.
CHUNK_MINUTES=10
MAX_UPLOAD_MB=500
